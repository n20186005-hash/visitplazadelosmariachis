# Header rules applied by the Cloudflare Workers static assets deployment.
#
# Host-level redirects are handled in `src/worker.ts`, while this file keeps
# response headers and cache policies for the static assets themselves.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/sw.js
  Cache-Control: no-cache

/gallery/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800
